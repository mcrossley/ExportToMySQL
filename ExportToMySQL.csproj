<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>ExportToMySQL</AssemblyTitle>
    <Description>Exports Cumulus data files to MySQL</Description>
    <Product>ExportToMySQL</Product>
    <Copyright>Copyright ©  2015-$([System.DateTime]::Now.ToString('yyyy') Cumulus MX</Copyright>
    <AssemblyVersion>$(PackageVersion)</AssemblyVersion>
    <FileVersion>$(PackageVersion)</FileVersion>
    <Version>4.0.0.0006</Version>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="packages\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(Configuration)==Release (&#xD;&#xA;echo.&#xD;&#xA;echo Update Distribution folder&#xD;&#xA;if $(Platform)==x86 (&#xD;&#xA;  echo copy x86 exe&#xD;&#xA;  xcopy &quot;$(OutputPath)\ExportToMySQL.exe&quot; &quot;$(SolutionDir)..\CumulusMX-Dist.Net\CumulusMX\ExportToMySQL32.exe&quot; /D /-I /Y&#xD;&#xA;)&#xD;&#xA;if $(Platform)==AnyCPU (&#xD;&#xA;  echo copy exe - AnyCPU&#xD;&#xA;  xcopy &quot;$(TargetPath)&quot; &quot;$(ProjectDir)..\CumulusMX-Dist.Net\CumulusMX&quot; /D /-I /Q /Y&#xD;&#xA;  xcopy &quot;$(OutputPath)\ExportToMySQL.exe&quot; &quot;$(ProjectDir)..\CumulusMX-Dist.Net\CumulusMX&quot; /D /-I /Q /Y&#xD;&#xA;)&#xD;&#xA;echo copy config&#xD;&#xA;xcopy &quot;$(TargetPath).config&quot; &quot;$(ProjectDir)..\CumulusMX-Dist.Net\CumulusMX&quot; /D /-I /Q /Y&#xD;&#xA;xcopy &quot;$(OutputPath)\ExportToMySQL.runtimeconfig.json&quot; &quot;$(ProjectDir)..\CumulusMX-Dist.Net\CumulusMX&quot; /D /-I /Q /Y&#xD;&#xA;xcopy &quot;$(OutputPath)\ExportToMySQL.deps.json&quot; &quot;$(ProjectDir)..\CumulusMX-Dist.Net\CumulusMX&quot; /D /-I /Q /Y&#xD;&#xA;)" />
  </Target>
</Project>